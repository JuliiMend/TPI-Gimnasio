@using API.Clients
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            Gimnasio
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable">

    <nav class="nav flex-column">

        @if (rol != null)
        {
            <div class="px-3 py-2 text-white-50 small">
                @username (@rol)
            </div>
        }

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span aria-hidden="true">🏠</span>
                Inicio
            </NavLink>
        </div>

        @foreach (var item in itemsVisibles)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="@item.Href">
                    <span aria-hidden="true">@item.Icono</span>
                    @item.Texto
                </NavLink>
            </div>
        }

        @if (rol != null)
        {
            <div class="nav-item px-3 mt-3">
                <button class="nav-link btn btn-link text-start w-100" @onclick="CerrarSesion">
                    <span aria-hidden="true">🚪</span>
                    Cerrar sesión
                </button>
            </div>
        }
    </nav>

</div>

@code {
    private record ItemMenu(string Href, string Icono, string Texto, string[] Roles);

    // Opciones del menú y qué roles las ven (misma matriz que valida la API)
    private static readonly ItemMenu[] items =
    {
        new("/planes", "📋", "Planes", new[] { Roles.Admin }),
        new("/planes", "📋", "Mi plan", new[] { Roles.Socio }),
        new("/actividades", "🤸", "Actividades", new[] { Roles.Admin }),
        new("/clases", "📅", "Clases", new[] { Roles.Admin, Roles.Socio }),
        new("/clases", "📅", "Mis clases", new[] { Roles.Profesor }),
        new("/inscripciones", "✍️", "Inscripciones", new[] { Roles.Admin, Roles.Profesor }),
        new("/inscripciones", "✍️", "Mis inscripciones", new[] { Roles.Socio }),
        new("/socios", "👥", "Socios", new[] { Roles.Admin }),
        new("/profesores", "👨‍🏫", "Profesores", new[] { Roles.Admin }),
        new("/turnos", "🕐", "Turnos", new[] { Roles.Admin }),
        new("/cuotas", "💰", "Cuotas", new[] { Roles.Admin }),
        new("/cuotas", "💰", "Mis cuotas", new[] { Roles.Socio }),
        new("/maquinas", "🏋️", "Máquinas", new[] { Roles.Admin }),
        new("/materiales", "📦", "Materiales", new[] { Roles.Admin }),
        new("/mantenimientos", "🔧", "Mantenimientos", new[] { Roles.Admin }),
        new("/historico-sueldos", "💵", "Histórico de sueldos", new[] { Roles.Admin }),
        new("/historico-sueldos", "💵", "Mi histórico de sueldos", new[] { Roles.Profesor }),
        new("/administradores", "🛡️", "Administradores", new[] { Roles.Admin }),
        new("/usuarios", "👤", "Usuarios", new[] { Roles.Admin })
    };

    private string? rol;
    private string? username;
    private IEnumerable<ItemMenu> itemsVisibles = Enumerable.Empty<ItemMenu>();

    private IAuthService authService = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        authService = AuthServiceProvider.Instance;
        authService.AuthenticationStateChanged += AlCambiarSesion;

        await ActualizarMenu();
    }

    private async Task ActualizarMenu()
    {
        rol = await authService.GetRolAsync();
        username = await authService.GetUsernameAsync();
        itemsVisibles = items.Where(i => rol != null && i.Roles.Contains(rol)).ToList();
    }

    // El menú vive en el layout y no se recrea al loguearse: se refresca con el evento
    private void AlCambiarSesion(bool autenticado)
    {
        _ = InvokeAsync(async () =>
        {
            await ActualizarMenu();
            StateHasChanged();
        });
    }

    private async Task CerrarSesion()
    {
        await authService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        authService.AuthenticationStateChanged -= AlCambiarSesion;
    }
}
