@page "/"
@using API.Clients

<PageTitle>Inicio</PageTitle>

<div class="text-center mb-5">
    <h1>Gimnasio</h1>
    <p class="lead">
        @(rol == Roles.Admin ? "Panel de administración" : $"Bienvenido/a, {username}")
    </p>
</div>

<div class="row">

    @foreach (var tarjeta in tarjetasVisibles)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">
                    <h4>@tarjeta.Titulo</h4>
                    <p>@tarjeta.Descripcion</p>

                    <a href="@tarjeta.Href" class="btn btn-primary">
                        @tarjeta.Boton
                    </a>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private record Tarjeta(string Href, string Titulo, string Descripcion, string Boton, string[] Roles);

    private static readonly Tarjeta[] tarjetas =
    {
        // Admin
        new("/planes", "Planes", "Consultar los planes disponibles del gimnasio.", "Ver planes", new[] { Roles.Admin }),
        new("/actividades", "Actividades", "Gestionar los tipos de actividad que incluyen los planes.", "Gestionar actividades", new[] { Roles.Admin }),
        new("/clases", "Clases", "Gestionar las clases: actividad, profesor, turno y cupo.", "Gestionar clases", new[] { Roles.Admin }),
        new("/inscripciones", "Inscripciones", "Inscribir socios a clases controlando el cupo.", "Gestionar inscripciones", new[] { Roles.Admin }),
        new("/socios", "Socios", "Gestionar los socios del gimnasio.", "Gestionar socios", new[] { Roles.Admin }),
        new("/profesores", "Profesores", "Gestionar los profesores del gimnasio.", "Gestionar profesores", new[] { Roles.Admin }),
        new("/turnos", "Turnos", "Gestionar los turnos disponibles.", "Gestionar turnos", new[] { Roles.Admin }),
        new("/cuotas", "Cuotas", "Gestionar las cuotas y sus detalles.", "Gestionar cuotas", new[] { Roles.Admin }),
        new("/administradores", "Administradores", "Gestionar los administradores del gimnasio.", "Gestionar administradores", new[] { Roles.Admin }),
        new("/usuarios", "Usuarios", "Gestionar los usuarios del sistema.", "Gestionar usuarios", new[] { Roles.Admin }),
        new("/maquinas", "Máquinas", "Gestionar las máquinas del gimnasio.", "Gestionar máquinas", new[] { Roles.Admin }),
        new("/materiales", "Materiales", "Gestionar los materiales del gimnasio.", "Gestionar materiales", new[] { Roles.Admin }),
        new("/mantenimientos", "Mantenimientos", "Registrar mantenimientos y ver el reporte por máquina.", "Ver mantenimientos", new[] { Roles.Admin }),
        new("/historico-sueldos", "Histórico de sueldos", "Consultar el histórico de sueldos de los profesores.", "Ver histórico", new[] { Roles.Admin }),

        // Profesor
        new("/clases", "Mis clases", "Consultar las clases que tenés a cargo.", "Ver mis clases", new[] { Roles.Profesor }),
        new("/inscripciones", "Inscriptos", "Ver los socios inscriptos a tus clases.", "Ver inscriptos", new[] { Roles.Profesor }),
        new("/historico-sueldos", "Mi histórico de sueldos", "Consultar tus sueldos vigentes y anteriores.", "Ver mis sueldos", new[] { Roles.Profesor }),

        // Socio
        new("/planes", "Mi plan", "Ver tu plan y las actividades que incluye.", "Ver mi plan", new[] { Roles.Socio }),
        new("/clases", "Clases", "Ver las clases disponibles y su cupo.", "Ver clases", new[] { Roles.Socio }),
        new("/inscripciones", "Mis inscripciones", "Inscribirte a clases o cancelar tus inscripciones.", "Ver mis inscripciones", new[] { Roles.Socio }),
        new("/cuotas", "Mis cuotas", "Consultar tus cuotas pagas.", "Ver mis cuotas", new[] { Roles.Socio })
    };

    private string? rol;
    private string? username;
    private IEnumerable<Tarjeta> tarjetasVisibles = Enumerable.Empty<Tarjeta>();

    protected override async Task OnInitializedAsync()
    {
        rol = await AuthServiceProvider.Instance.GetRolAsync();
        username = await AuthServiceProvider.Instance.GetUsernameAsync();
        tarjetasVisibles = tarjetas.Where(t => rol != null && t.Roles.Contains(rol)).ToList();
    }
}
