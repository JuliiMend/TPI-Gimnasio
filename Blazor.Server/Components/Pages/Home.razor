@page "/"

<PageTitle>Inicio</PageTitle>

<div class="text-center mb-5">
    <h1>Gimnasio</h1>
    <p class="lead">
        Panel de administración
    </p>
</div>

<div class="row">

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Planes</h4>
                <p>Consultar los planes disponibles del gimnasio.</p>

                <a href="/planes" class="btn btn-primary">
                    Ver planes
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Actividades</h4>
                <p>Gestionar los tipos de actividad que incluyen los planes.</p>

                <a href="/actividades" class="btn btn-primary">
                    Gestionar actividades
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Clases</h4>
                <p>Gestionar las clases: actividad, profesor, turno y cupo.</p>

                <a href="/clases" class="btn btn-primary">
                    Gestionar clases
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Inscripciones</h4>
                <p>Inscribir socios a clases controlando el cupo.</p>

                <a href="/inscripciones" class="btn btn-primary">
                    Gestionar inscripciones
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Socios</h4>
                <p>Gestionar los socios del gimnasio.</p>

                <a href="/socios" class="btn btn-primary">
                    Gestionar socios
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Profesores</h4>
                <p>Gestionar los profesores del gimnasio.</p>

                <a href="/profesores" class="btn btn-primary">
                    Gestionar profesores
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Turnos</h4>
                <p>Gestionar los turnos disponibles.</p>

                <a href="/turnos" class="btn btn-primary">
                    Gestionar turnos
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Cuotas</h4>
                <p>Gestionar las cuotas y sus detalles.</p>

                <a href="/cuotas" class="btn btn-primary">
                    Gestionar cuotas
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Administradores</h4>
                <p>Gestionar los administradores del gimnasio.</p>

                <a href="/administradores" class="btn btn-primary">
                    Gestionar administradores
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Usuarios</h4>
                <p>Gestionar los usuarios del sistema.</p>

                <a href="/usuarios" class="btn btn-primary">
                    Gestionar usuarios
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Máquinas</h4>
                <p>Gestionar las máquinas del gimnasio.</p>

                <a href="/maquinas" class="btn btn-primary">
                    Gestionar máquinas
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Materiales</h4>
                <p>Gestionar los materiales del gimnasio.</p>

                <a href="/materiales" class="btn btn-primary">
                    Gestionar materiales
                </a>
            </div>
        </div>
    </div>

</div>
