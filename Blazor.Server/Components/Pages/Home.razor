@page "/"

<PageTitle>Inicio</PageTitle>

<div class="text-center mb-5">
    <h1>Gimnasio</h1>
    <p class="lead">
        Panel de administración
    </p>
</div>

<div class="row">

    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Planes</h4>
                <p>Consultar los planes disponibles del gimnasio.</p>

                <a href="/planes" class="btn btn-primary">
                    Ver planes
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Socios</h4>
                <p>Gestionar los socios del gimnasio.</p>

                <a href="/socios" class="btn btn-primary">
                    Gestionar socios
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Profesores</h4>
                <p>Gestionar los profesores del gimnasio.</p>

                <a href="/profesores" class="btn btn-primary">
                    Gestionar profesores
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Turnos</h4>
                <p>Gestionar los turnos disponibles.</p>

                <a href="/turnos" class="btn btn-primary">
                    Gestionar turnos
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Cuotas</h4>
                <p>Gestionar las cuotas y sus detalles.</p>

                <a href="/cuotas" class="btn btn-primary">
                    Gestionar cuotas
                </a>
            </div>
        </div>
    </div>


    <div class="col-md-4 mb-4">
        <div class="card h-100">
            <div class="card-body">
                <h4>Usuarios</h4>
                <p>Gestionar los usuarios del sistema.</p>

                <a href="/usuarios" class="btn btn-primary">
                    Gestionar usuarios
                </a>
            </div>
        </div>
    </div>

</div>
