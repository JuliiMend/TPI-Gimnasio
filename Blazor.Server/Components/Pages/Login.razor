@page "/login"
@using API.Clients
@rendermode InteractiveServer

<PageTitle>Login</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">

        <div class="card p-4 mt-5">

            <h3 class="text-center mb-4">Iniciar sesión</h3>

            <form @onsubmit="IniciarSesion">

                <div class="mb-3">
                    <label>Usuario</label>
                    <input class="form-control" @bind="username" @bind:event="oninput" />
                </div>

                <div class="mb-3">
                    <label>Contraseña</label>
                    <input type="password" class="form-control" @bind="password" @bind:event="oninput" />
                </div>

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert alert-danger">
                        @mensaje
                    </div>
                }

                <button type="submit" class="btn btn-primary w-100">
                    Iniciar sesión
                </button>

            </form>

        </div>

    </div>
</div>

@code {

    private string username = string.Empty;
    private string password = string.Empty;
    private string mensaje = string.Empty;

    private async Task IniciarSesion()
    {
        mensaje = string.Empty;

        if (string.IsNullOrWhiteSpace(username) ||
            string.IsNullOrWhiteSpace(password))
        {
            mensaje = "Completá usuario y contraseña.";
            return;
        }

        var authService = AuthServiceProvider.Instance;

        try
        {
            var resultado = await authService.LoginAsync(username.Trim(), password);

            if (resultado.Exito)
            {
                NavigationManager.NavigateTo("/");
            }
            else
            {
                mensaje = resultado.Mensaje;
                password = string.Empty;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo conectar con el servidor: {ex.Message}";
        }
    }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}