@page "/profesores"
@using DTOs
@using API.Clients

<h3>Profesores</h3>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="NuevoProfesor">
        + Nuevo profesor
    </button>
</div>

@if (mostrarFormulario)
{
    <div class="card p-4 mb-4">
        <h4>@(editando ? "Editar profesor" : "Nuevo profesor")</h4>

        <div class="row">

            <div class="col-md-6 mb-3">
                <label>DNI</label>
                <input class="form-control" @bind="profesorActual.Dni" />

                @if (!string.IsNullOrEmpty(errorDni))
                {
                    <div class="text-danger">@errorDni</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label>Nombre</label>
                <input class="form-control" @bind="profesorActual.Nombre" />

                @if (!string.IsNullOrEmpty(errorNombre))
                {
                    <div class="text-danger">@errorNombre</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label>Apellido</label>
                <input class="form-control" @bind="profesorActual.Apellido" />

                @if (!string.IsNullOrEmpty(errorApellido))
                {
                    <div class="text-danger">@errorApellido</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label>Teléfono</label>
                <input class="form-control" @bind="profesorActual.Telefono" />

                @if (!string.IsNullOrEmpty(errorTelefono))
                {
                    <div class="text-danger">@errorTelefono</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label>Fecha de nacimiento</label>
                <input type="date" class="form-control" @bind="profesorActual.FechaNac" />

                @if (!string.IsNullOrEmpty(errorFechaNac))
                {
                    <div class="text-danger">@errorFechaNac</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label>Cargo</label>
                <input class="form-control" @bind="profesorActual.Cargo" />

                @if (!string.IsNullOrEmpty(errorCargo))
                {
                    <div class="text-danger">@errorCargo</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label>Username</label>
                <input class="form-control" @bind="profesorActual.Username" />

                @if (!string.IsNullOrEmpty(errorUsername))
                {
                    <div class="text-danger">@errorUsername</div>
                }
            </div>

            <div class="col-md-6 mb-3">
                <label>Email</label>
                <input type="email" class="form-control" @bind="profesorActual.Email" />

                @if (!string.IsNullOrEmpty(errorEmail))
                {
                    <div class="text-danger">@errorEmail</div>
                }
            </div>

            @if (!editando)
            {
                <div class="col-md-6 mb-3">
                    <label>Password</label>
                    <input type="password"
                           class="form-control"
                           @bind="profesorActual.Password" />

                    @if (!string.IsNullOrEmpty(errorPassword))
                    {
                        <div class="text-danger">@errorPassword</div>
                    }
                </div>
            }

    </div>

    <div>
        <button class="btn btn-success me-2" @onclick="Guardar">
            Guardar
        </button>

        <button class="btn btn-secondary" @onclick="Cancelar">
            Cancelar
        </button>
    </div>
</div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-info">
        @mensaje
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Teléfono</th>
            <th>Cargo</th>
            <th>Email</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var profesor in profesores)
        {
            <tr>
                <td>@profesor.Dni</td>
                <td>@profesor.Nombre</td>
                <td>@profesor.Apellido</td>
                <td>@profesor.Telefono</td>
                <td>@profesor.Cargo</td>
                <td>@profesor.Email</td>
                <td>
                    @(profesor.UsuarioActivo ? "Activo" : "Inactivo")
                </td>
                <td>
                    <button class="btn btn-sm btn-warning me-2"
                            @onclick="() => EditarProfesor(profesor)">
                        Editar
                    </button>

                    <button class="btn btn-sm btn-danger"
                            @onclick="() => EliminarProfesor(profesor)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
private bool mostrarFormulario = false;
    private bool editando = false;

    private string mensaje = string.Empty;

    private string errorDni = string.Empty;
    private string errorNombre = string.Empty;
    private string errorApellido = string.Empty;
    private string errorTelefono = string.Empty;
    private string errorFechaNac = string.Empty;
    private string errorCargo = string.Empty;
    private string errorUsername = string.Empty;
    private string errorEmail = string.Empty;
    private string errorPassword = string.Empty;

    private ProfesorCreaActualizaDTO profesorActual = new();

    private int idProfesorEditando;

    private List<ProfesorMostrarDTO> profesores = new();

    protected override async Task OnInitializedAsync()
    {
        await CargarProfesores();
    }

    private async Task CargarProfesores()
    {
        try
        {
            profesores = (await ProfesorApiClient.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar los profesores: {ex.Message}";
        }
    }

    private void LimpiarErrores()
    {
        errorDni = string.Empty;
        errorNombre = string.Empty;
        errorApellido = string.Empty;
        errorTelefono = string.Empty;
        errorFechaNac = string.Empty;
        errorCargo = string.Empty;
        errorUsername = string.Empty;
        errorEmail = string.Empty;
        errorPassword = string.Empty;
    }

    private void NuevoProfesor()
    {
        profesorActual = new ProfesorCreaActualizaDTO();

        editando = false;
        mostrarFormulario = true;
        mensaje = string.Empty;

        LimpiarErrores();
    }

    private void EditarProfesor(ProfesorMostrarDTO profesor)
    {
        idProfesorEditando = profesor.IdPersona;

        profesorActual = new ProfesorCreaActualizaDTO
        {
            Dni = profesor.Dni,
            Nombre = profesor.Nombre,
            Apellido = profesor.Apellido,
            Telefono = profesor.Telefono,
            FechaNac = profesor.FechaNac,
            Cargo = profesor.Cargo,
            Username = profesor.Username,
            Email = profesor.Email
        };

        editando = true;
        mostrarFormulario = true;
        mensaje = string.Empty;

        LimpiarErrores();
    }

    private bool Validar()
    {
        LimpiarErrores();

        bool valido = true;

        if (string.IsNullOrWhiteSpace(profesorActual.Dni))
        {
            errorDni = "Ingresá el DNI.";
            valido = false;
        }

        if (string.IsNullOrWhiteSpace(profesorActual.Nombre))
        {
            errorNombre = "Ingresá el nombre.";
            valido = false;
        }

        if (string.IsNullOrWhiteSpace(profesorActual.Apellido))
        {
            errorApellido = "Ingresá el apellido.";
            valido = false;
        }

        if (string.IsNullOrWhiteSpace(profesorActual.Telefono))
        {
            errorTelefono = "Ingresá el teléfono.";
            valido = false;
        }

        if (profesorActual.FechaNac == DateTime.MinValue)
        {
            errorFechaNac = "Ingresá la fecha de nacimiento.";
            valido = false;
        }

        if (string.IsNullOrWhiteSpace(profesorActual.Cargo))
        {
            errorCargo = "Ingresá el cargo.";
            valido = false;
        }

        if (string.IsNullOrWhiteSpace(profesorActual.Username))
        {
            errorUsername = "Ingresá el username.";
            valido = false;
        }

        if (string.IsNullOrWhiteSpace(profesorActual.Email))
        {
            errorEmail = "Ingresá el email.";
            valido = false;
        }

        if (!editando && string.IsNullOrWhiteSpace(profesorActual.Password))
        {
            errorPassword = "Ingresá una contraseña.";
            valido = false;
        }

        return valido;
    }

    private async Task Guardar()
    {
        if (!Validar())
        {
            return;
        }

        try
        {
            if (editando)
            {
                await ProfesorApiClient.UpdateAsync(
                    idProfesorEditando,
                    profesorActual);

                mensaje = "Profesor modificado correctamente.";
            }
            else
            {
                await ProfesorApiClient.AddAsync(profesorActual);

                mensaje = "Profesor creado correctamente.";
            }

            await CargarProfesores();

            mostrarFormulario = false;
        }
        catch (Exception ex)
        {
            mensaje = $"Error al guardar el profesor: {ex.Message}";
        }
    }

    private async Task EliminarProfesor(ProfesorMostrarDTO profesor)
    {
        try
        {
            await ProfesorApiClient.DeleteAsync(profesor.IdPersona);

            await CargarProfesores();

            mensaje = "Profesor eliminado correctamente.";
        }
        catch (Exception ex)
        {
            mensaje = $"Error al eliminar el profesor: {ex.Message}";
        }
    }

    private void Cancelar()
    {
        mostrarFormulario = false;
        mensaje = string.Empty;

        LimpiarErrores();
    }
}
