@page "/planes"
@using DTOs
@using API.Clients

<h3>Planes</h3>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-info">
        @mensaje
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Precio</th>
            <th>Descripción</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var plan in planes)
        {
            <tr>
                <td>@plan.Nombre</td>
                <td>@plan.Tipo</td>
                <td>$@plan.Precio</td>
                <td>@plan.Descripcion</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<PlanMostrarDTO> planes = new();
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CargarPlanes();
    }

    private async Task CargarPlanes()
    {
        try
        {
            planes = (await PlanApiClient.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            mensaje = $"Error al cargar los planes: {ex.Message}";
        }
    }
}